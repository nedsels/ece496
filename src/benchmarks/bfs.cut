#include <scheduler/enum.cuh>
#include <benchmarks/benchmarks.cuh>

#include <cuda_runtime.h>

#include <cassert>
#include <climits>
#include <cstdlib>
#include <cstring>
#include <iostream>

#ifndef COOP_VERSION
template <typename GraphType, typename SchedulerType>
static __global__ void bfs_kernel(GraphType graph,
                                  typename GraphType::index_type source,
                                  unsigned* dist, SchedulerType* scheduler);
#endif

#ifdef COOP_VERSION
// Experimental
// Version of kernel that uses cooperative warp strategy
template <typename GraphType, typename SchedulerType>
static __global__ void bfs_kernel_coop_warp(
	GraphType graph, typename GraphType::index_type source,
    unsigned* dist, SchedulerType* scheduler, const size_t stage_capacity
);

// TODO: Move to common if other kernels adopt this
template <typename TaskType, typename SchedulerType>
__device__ void flush_stage(const size_t stage_count, TaskType *stage, SchedulerType * scheduler);

#endif

template <typename GraphType>
Benchmarks::Status BFS<GraphType>::init(const GraphType& graph, const Benchmarks::BenchmarkConfig& config) {
	if (initialized) {
		return Benchmarks::Status::ERROR;
	}
	nnodes = graph.nnodes;
	distances_bytes = nnodes * sizeof(unsigned);
	src = static_cast<typename GraphType::index_type>(config.source.value());

	h_distances = static_cast<unsigned*>(malloc(distances_bytes));
	if (h_distances == nullptr) {
		free(h_distances);
		return Benchmarks::Status::ERROR;
	}

	memset(h_distances, 0xff, distances_bytes);
	CUDA_CHECK(
		cudaMalloc(reinterpret_cast<void**>(&d_distances), distances_bytes)
	);

	initialized = true;

	return Benchmarks::Status::SUCCESS;
}

template <typename GraphType>
Benchmarks::Status BFS<GraphType>::copy_to_device() {
	CUDA_CHECK(cudaMemcpy(d_distances, h_distances, distances_bytes, 
		cudaMemcpyHostToDevice));

	return Benchmarks::Status::SUCCESS;
}

template <typename GraphType>
Benchmarks::Status BFS<GraphType>::copy_to_host() {
	CUDA_CHECK(cudaMemcpy(h_distances, d_distances, distances_bytes,
						cudaMemcpyDeviceToHost));
	return Benchmarks::Status::SUCCESS;
}

template <typename GraphType>
template <typename SchedulerType>
Benchmarks::Status BFS<GraphType>::solve(
	GraphType d_graph, SchedulerType* d_scheduler, const cudaDeviceProp& prop
) {
	const unsigned num_blocks = prop.multiProcessorCount >> 1;
	
	cudaEvent_t start, stop;
	CUDA_CHECK(cudaEventCreate(&start));
  	CUDA_CHECK(cudaEventCreate(&stop));

	CUDA_CHECK(cudaEventRecord(start));

#ifndef COOP_VERSION
	const unsigned block_size = prop.maxThreadsPerBlock >> 1;
	bfs_kernel<<<num_blocks, block_size>>>(
		d_graph, src, d_distances, d_scheduler
	);
#endif
#ifdef COOP_VERSION
	// TODO: tune the shared memory size
	constexpr size_t WARPS_PER_BLOCK = 8; /* 256 threads */
	constexpr size_t STAGE_CAP = 256;
	const unsigned block_size = WARPS_PER_BLOCK << 5;
	
	assert(WARPS_PER_BLOCK <= prop.sharedMemPerBlock / sizeof(SMem));
	const unsigned shared_mem_size_alloc = WARPS_PER_BLOCK * sizeof(SMem);
	printf("Starting kernel\n");
	bfs_kernel_coop_warp<<<num_blocks, block_size, shared_mem_size_alloc>>>(
		d_graph, src, d_distances, d_scheduler, STAGE_CAP
	);
#endif
	CUDA_CHECK(cudaGetLastError());
	CUDA_CHECK(cudaEventRecord(stop));
	CUDA_CHECK(cudaDeviceSynchronize());
	CUDA_CHECK(cudaEventElapsedTime(&kernel_ms, start, stop));

	CUDA_CHECK(cudaEventDestroy(start));
	CUDA_CHECK(cudaEventDestroy(stop));

	return Benchmarks::Status::SUCCESS;
}

template <typename GraphType>
void BFS<GraphType>::print_result() {
	std::cout << "Distances by vertex from " << src << ": \n";
	for (index_type i = 0; i < nnodes; i++) {
	std::cout << i << ":" << h_distances[i] << " ";
	}
	std::cout << std::endl;
}

template <typename GraphType>
Benchmarks::Status BFS<GraphType>::write_results(const char* path) {
  FILE* file = fopen(path, "wb");
  if (file == nullptr) {
    std::cerr << "Unable to open output file: " << path << '\n';
    return Benchmarks::Status::ERROR;
  }
  const size_t written = fwrite(h_distances, sizeof(unsigned), nnodes, file);
  const bool closed = fclose(file) == 0;
  if (written != static_cast<size_t>(nnodes) || !closed) {
    std::cerr << "Failed writing output file: " << path << '\n';
    return Benchmarks::Status::ERROR;
  }
  return Benchmarks::Status::SUCCESS;
}

template <typename GraphType>
Benchmarks::Status BFS<GraphType>::dealloc() {
	free(h_distances);
	cudaFree(d_distances);
	return Benchmarks::Status::SUCCESS;
}

#ifndef COOP_VERSION
template <typename GraphType, typename SchedulerType>
static __global__ void bfs_kernel(
	GraphType graph, typename GraphType::index_type source,
    unsigned* dist, SchedulerType* scheduler
) {
	const unsigned thread_id = blockIdx.x * blockDim.x + threadIdx.x;
	const unsigned lane_id = thread_id & 31;

	using task_type = typename BFS<GraphType>::TaskType;
	using index_type = typename GraphType::index_type;

	task_type source_task = {source, 0};
	unsigned num_tasks = 0;
	if (thread_id == 0) {
		atomicExch(&(dist[source]), 0);
		num_tasks = 1;
	}
	scheduler->push(&source_task, num_tasks, lane_id);

	task_type task;
	unsigned tasks_read;
	while (scheduler->pop(&task, &tasks_read, warpSize, blockIdx.x, lane_id) != POP_DONE) {
		task_type* new_tasks = nullptr;
		unsigned num_new_tasks = 0;
		// pop() writes to the lowest lanes
		if (lane_id < tasks_read) {
			index_type v = task.item;
			unsigned prev_dist = task.priority;
			unsigned curr_dist = dist[v];
			index_type degree = graph.getOutDegree(v);
			if (curr_dist == prev_dist && degree > 0) {
				new_tasks = (task_type*)malloc(degree * sizeof(task_type));
				if (new_tasks == nullptr) {
					// Device heap exhausted; abort the kernel so the host sees an error
					// instead of silently dropping tasks.
					printf("bfs_kernel: device malloc of %u tasks failed\n", (unsigned)degree);
					__trap();
				}
				for (index_type e_rel = 0; e_rel < degree; e_rel++) {
					index_type nbr = graph.getDestination(v, e_rel);
					unsigned new_dist = curr_dist + 1;
					if (atomicMin(dist + nbr, new_dist) > new_dist) {
						new_tasks[num_new_tasks++] = {nbr, new_dist};
					}
				}
			}
		}
		if (scheduler->push(new_tasks, num_new_tasks, lane_id) == PUSH_DEADLOCK) {
			printf("Deadlock\n");
			assert(false);
		}
		if (new_tasks != nullptr) {
			free(new_tasks);
		}
	}
}
#endif

// Each lane pops a task from the scheduler
// Each task represents a vertex to process
// If we determine the task is not stale (i.e. distance is up to date with global result), we push the vertex into a work pool
// This work pool is in shared memory. Work is shared between warps
// Use memory coalescing when lanes process edges (do strided access instead of chunked)
// Push new tasks to a stage in shared memory to avoid doing dynamic memory allocation
// When the stage is full, push to the scheduler
// Repeat until work pool drained

// TODO
// The work pool strategy ensures intra-warp load balancing BUT NOT inter-warp load balancing
// For example, one warp can get unlucky with a bunch of high degree vertices while every other warp only gets low degree vertices
// Other warps stall while they wait for the warp pinned by high degree vertices
// Ideas:
// Limit edges to process per task (i.e. each task now has vertex, priority, edge_start, edge_end)
// This means that one vertex may have many tasks generated for it
// This strategy guarantees the maximum edge work load is edge_range * 32 --> solves inter-warp load balancing
// Trade off is tasks now store more metadata (and shared memory is precious) and more tasks per vertex can lead to more severe work inefficiency
// Instead of just one redundant task, we now have N redundant tasks. More tasks also means greater scheduler overhead (more push/pop)
//
// Instead of splitting a vertex's edge set at push, do it at pop
// Each task now stores vertex, priority, cur_edge
// When we pop a task, only process N edges of the vertex
// On push, push the up to N new tasks and the old task with updated cur_edge + N
// This maintains one task per vertex, but now processing a single vertex's edges will take many push/pop cycles
// Task metadata still increases although by 4 less bytes that splitting at push
// 
// Currently, the shared memory optimization exists in the kernel, but this can be moved into the scheduler
// We need to call some init function in the kernel so the scheduler has a pointer to the shared memory for the block
// The scheduler pop can then directly move tasks from global (or wherever they are) into the calling warp's share memory space
// The warp lanes will just see a populated work pool
// The stage interface can also be put into the scheduler; lanes call push which will buffer to a stage first and then push to
// global (or wherever the tasks need to go) on some policy
#ifdef COOP_VERSION
template <typename GraphType, typename SchedulerType>
static __global__ void bfs_kernel_coop_warp(
	GraphType graph, typename GraphType::index_type source,
    unsigned* dist, SchedulerType* scheduler, const size_t stage_capacity
) {
	// Globally (entire grid) unique thread ID
	const unsigned thread_id = blockIdx.x * blockDim.x + threadIdx.x;
	const unsigned lane_id = threadIdx.x & 31;

	using task_type = typename BFS<GraphType>::TaskType;
	using index_type = typename GraphType::index_type;
	using vertex_info = typename BFS<GraphType>::Vertex;
	using smem = typename BFS<GraphType>::SMem;

	extern __shared__ __align__(16) unsigned char smem_raw[];
	smem *all = reinterpret_cast<smem *>(smem_raw);
	// This warp's private region
	smem &warp_mem = all[threadIdx.x >> 5];
	vertex_info *work_pool = warp_mem.work_pool;
	task_type *stage = warp_mem.stage;
	size_t stage_count = 0; /* Uniform across warps */

	// Seed scheduler with source
	task_type source_task = {source, 0};
	unsigned num_tasks = 0;
	if (thread_id == 0) {
		atomicExch(&(dist[source]), 0);
		num_tasks = 1;
	}
	scheduler->push(&source_task, num_tasks, lane_id);

	task_type task;
	unsigned tasks_read;
	while (scheduler->pop(&task, &tasks_read, warpSize, blockIdx.x, lane_id) != POP_DONE) {
		index_type degree = 0;
		vertex_info vertex = {0, 0, 0};
		// pop() writes to the lowest lanes
		if (lane_id < tasks_read) {
			const index_type v = task.item;
			const unsigned prev_dist = task.priority;
			// Force memory read -- avoid stale cache
			const unsigned curr_dist = *(volatile unsigned*)&dist[v];
			const index_type d = graph.getOutDegree(v);
			// There is work to do
			if (curr_dist == prev_dist && degree > 0) {
				// Create work item to push into task pool
				vertex = {
					.id = v,
					.degree = degree,
					.priority = prev_dist
				};
				degree = d;
			}
		}
		work_pool[lane_id] = vertex;
		__syncwarp(); // All lanes must complete write
		printf("thread %llu initial tasks\n", threadIdx.x);

		// Inclusive prefix
		index_type prefix = degree;
		// Get total number of edges this warp will process via prefix sum
		for (size_t i = 1; i < warpSize; i <<= 1) {
			int n = __shfl_up_sync(FULL_MASK, prefix, i);
			if (lane_id >= i) prefix += n;
		}
		const index_type total_edges = __shfl_sync(FULL_MASK, prefix, 31);
		printf("thread %llu prefix calculated\n", threadIdx.x);

		// Determine work load of this lane, lower lanes get remainder
		const index_type base = total_edges >> 5;
		const index_type remainder = total_edges & 31;
		// Workload this lane is responsible for
		const index_type edges_to_process = base + (lane_id < remainder);

		// Do strided access for edges rather than chunked to exhibit memory coalescing
		// Lanes access with 32 edge stride
		unsigned slot = 0;
		index_type e_offset = lane_id;
		vertex_info cur_v = work_pool[slot];
		// Need to ensure every lane does this loop the same number of times or else deadlock
		const size_t lane_iters = base + (remainder ? 1 : 0);
		for (size_t i = 0; i < lane_iters; ++i, e_offset += warpSize) {
			printf("Block ID: %llu Lane: %llu Slot: %llu e_off: %llu\n", blockIdx.x, lane_id, slot, e_offset);
			bool push_task = false;
			task_type new_task;
			// Still has work to do
			if (i < edges_to_process) {
				// Move to next slot when offset out of bounds
				while (e_offset >= cur_v.degree) {
					e_offset -= cur_v.degree;
					cur_v = work_pool[++slot];
				}
				index_type nbr = graph.getDestination(cur_v.id, e_offset);
				const unsigned new_dist = cur_v.priority + 1;
				// Atomic compare to global
				if (atomicMin(dist + nbr, new_dist) > new_dist) {
					push_task = true;
					new_task.item = nbr;
					new_task.priority = new_dist;
				}
			}
			// If new task, stage it
			unsigned m = __ballot_sync(FULL_MASK, push_task);
			if (push_task) stage[stage_count + __popc(m & ((1u << lane_id) - 1))] = new_task;
			stage_count += __popc(m);
			// Flush stage if full
			if (stage_count > stage_capacity - warpSize) {
				__syncwarp();
				// Calls push
				flush_stage(stage_count, stage, scheduler);
				stage_count = 0;
				__syncwarp();
			}
		}
		
		// Flush any staged tasks
		printf("thread %llu End loop\n", threadIdx.x);
		__syncwarp();
		printf("thread %llu Before flush call\n", threadIdx.x);
		flush_stage(stage_count, stage, scheduler);
		printf("thread %llu returned flush call\n");
		stage_count = 0;
		__syncwarp();
	}
}

template <typename TaskType, typename SchedulerType>
__device__ void flush_stage(const size_t stage_count, TaskType *stage, SchedulerType * scheduler) {
	if (stage_count == 0) {
		return;
	}

	// TODO: Maybe change scheduler interface
	// Stage is stored for the entire warp, this API expects each lane to push separate tasks
	// We split the stage up amongst all lanes
	const unsigned lane_id = threadIdx.x & 31;
	const unsigned base = stage_count >> 5;
	const unsigned remainder = stage_count & 31;
	const unsigned tasks_to_push = base + (lane_id < remainder);
	const unsigned offset = base * lane_id + min(lane_id, remainder);
	printf("Attempt flush\n");
	if (scheduler->push(stage + offset, tasks_to_push, lane_id) == PUSH_DEADLOCK) {
		printf("Deadlock\n");
		assert(false);
	}
}

#endif
