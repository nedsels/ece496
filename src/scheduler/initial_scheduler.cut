#pragma once

#include <common/utils.cuh>

#include <cassert>

template <typename TaskType>
unsigned InitialScheduler<TaskType>::init(const unsigned byte_capacity,
                                          const unsigned num_blocks,
                                          const unsigned num_warps) {
  _on_device = 0;
  _byte_capacity = byte_capacity;
  _queue_capacity_bytes = 0;

  _num_warps = num_warps;
  _num_blocks = num_blocks;
  _num_sections = NUM_SECTIONS;
  _section_capacity = 0;
  _write_section = 0;
  _num_full_sections = 0;
  _num_warps_writing = 0;
  _num_empty_sections = _num_sections;
  _num_warps_reading = 0;

  return 1;
}

template <typename TaskType>
InitialScheduler<TaskType>*
InitialScheduler<TaskType>::device_setup(const cudaDeviceProp& prop) {
  // TODO: instead of carving up _d_alloc, determine how much memory we can
  // reserve for _queue, then use cudaMalloc for everything

  CUDA_CHECK(cudaMalloc((void**)&_d_alloc, _byte_capacity));
  char* curr = _d_alloc;
  CUDA_CHECK(cudaMemset(curr, 0, _byte_capacity));
  const char* end = curr + _byte_capacity;

  InitialScheduler<TaskType>* d_scheduler =
      reinterpret_cast<InitialScheduler<TaskType>*>(curr);
  const unsigned scheduler_bytes = sizeof(InitialScheduler<TaskType>);
  curr += scheduler_bytes;

  _section_metadata = reinterpret_cast<struct SectionMD*>(align_up<uintptr_t>(
      reinterpret_cast<uintptr_t>(curr), alignof(struct SectionMD)));
  curr = reinterpret_cast<char*>(_section_metadata) +
         (sizeof(struct SectionMD) * _num_sections);

  if (curr >= end) {
    device_dealloc();
    return nullptr;
  }

  _queue = reinterpret_cast<TaskType*>(align_up<uintptr_t>(
      reinterpret_cast<uintptr_t>(curr), alignof(TaskType)));
  _section_capacity = (end - reinterpret_cast<char*>(_queue)) /
                      (sizeof(TaskType) * _num_sections);
  _queue_capacity_bytes =
      _section_capacity * (sizeof(TaskType) * _num_sections);

  if (_section_capacity < prop.warpSize) {
    device_dealloc();
    return nullptr;
  }

  _on_device = 1;
  CUDA_CHECK(
      cudaMemcpy(d_scheduler, this, scheduler_bytes, cudaMemcpyHostToDevice));
  _on_device = 0;

  return d_scheduler;
}

template <typename TaskType>
unsigned InitialScheduler<TaskType>::device_dealloc() {
  cudaFree(_d_alloc);
  return 1;
}

template <typename TaskType>
__device__ PushResult InitialScheduler<TaskType>::push(
    TaskType* tasks, unsigned num_tasks, const unsigned lane_id) {

  // Used for deadlock detection
  if (lane_id == 0) {
    atomicAdd(&_num_warps_writing, 1);
  }

  // Each thread has num_tasks to push. In each iteration of the loop, if we can
  // write to the section, each lane writes 1 task if it has any left. Then,
  // decrement num_tasks, and increment the tasks pointer
  PushResult result = PUSH_FAILURE;
  while (true) {
    // If no lanes have tasks remaining, the push is done
    unsigned ballot = __ballot_sync(FULL_MASK, num_tasks);
    if (ballot == 0) {
      if (lane_id == 0) {
        atomicSub(&_num_warps_writing, 1);
      }
      result = PUSH_SUCCESS;
      break;
    }

    unsigned curr_section_idx = 0;
    bool section_busy = false;
    bool section_full = false;
    if (lane_id == 0) {
      // The next warp to push will write to the next section
      if (_num_sections > 1) {
        curr_section_idx = atomicInc(&_write_section, _num_sections - 1);
        assert(curr_section_idx < _num_sections);
      }
      section_busy = atomicExch(&(_section_metadata[curr_section_idx].busy), 1);
      section_full = _section_metadata[curr_section_idx].full;
    }

    // If section is busy reading, try again
    section_busy = __shfl_sync(FULL_MASK, section_busy, 0);
    if (section_busy) {
      continue;
    }

    // If section is full, release the section. Check if both all sections are
    // full and all warps are writing, in which case we are deadlocked.
    section_full = __shfl_sync(FULL_MASK, section_full, 0);
    if (section_full) {
      if (lane_id == 0) {
        section_busy =
            atomicExch(&(_section_metadata[curr_section_idx].busy), 0);
        assert(section_busy);
      }
      if (_num_full_sections == _num_sections &&
          _num_warps_writing == _num_warps) {
        result = PUSH_DEADLOCK;
        break;
      }
      continue;
    }

    curr_section_idx = __shfl_sync(FULL_MASK, curr_section_idx, 0);
    SectionMD secmd = _section_metadata[curr_section_idx];

    // ballot_sum represents the number of lanes that have a task to write
    unsigned ballot_sum = __popc(ballot);

    // Use the unwrapped version of resv_end (>=_section_capacity), as it makes
    // the logic just below simpler
    if (secmd.resv_end < secmd.resv_start) {
      secmd.resv_end += _section_capacity;
    }
    unsigned old_resv_end = secmd.resv_end;
    secmd.resv_end += ballot_sum;

    // If the warp wants to write too many tasks, only the lower lanes can
    // write. The section will become full.
    if (secmd.resv_end - secmd.resv_start >= _section_capacity) {
      secmd.resv_end = secmd.resv_start + _section_capacity;
      secmd.full = true;
      if (lane_id == 0) {
        atomicAdd(&_num_full_sections, 1);
      }
    }

    // Rewrap resv_end
    secmd.resv_end %= _section_capacity;
    old_resv_end %= _section_capacity;

    // resv_offset is the offset past old_resv_end that this lane will write
    const unsigned num_writing = secmd.resv_end - old_resv_end;
    const unsigned resv_offset = popc_below(ballot, lane_id);
    if (num_tasks > 0 && resv_offset < num_writing) {
      const unsigned section_offset = _section_capacity * curr_section_idx;
      const unsigned write_offset =
          (old_resv_end + resv_offset) % _section_capacity;
      *(_queue + section_offset + write_offset) = *tasks;
      num_tasks--;
      tasks++;
    }

    // Update global and section metadata
    __syncwarp();
    if (lane_id == 0) {
      const bool was_empty = old_resv_end == secmd.resv_start;
      if (was_empty) {
        atomicSub(&_num_empty_sections, 1);
      }

      _section_metadata[curr_section_idx] = secmd;
      __threadfence();

      const unsigned was_busy =
          atomicExch(&(_section_metadata[curr_section_idx].busy), 0);
      assert(was_busy);
    }
  }

  __syncwarp();
  return result;
}

template <typename TaskType>
__device__ PopResult InitialScheduler<TaskType>::pop(
    TaskType* dst, unsigned* tasks_popped, const unsigned warp_max_tasks,
    const unsigned block_id, const unsigned lane_id) {
  // All lanes should pass in the same warp_max_tasks
  const unsigned warp_max_tasks_l0 = __shfl_sync(FULL_MASK, warp_max_tasks, 0);
  assert(warp_max_tasks == warp_max_tasks_l0);

  *tasks_popped = 0;

  if (warp_max_tasks == 0) {
    __syncwarp();
    return POP_SUCCESS;
  }

  // Used to detect completion
  if (lane_id == 0) {
    atomicAdd(&_num_warps_reading, 1);
  }

  // Each block reads from sections block_id + k * _num_blocks, within bounds.
  // Start at the last "stride" of sections so the first iteration of the loop
  // checks stride 0. NOTE: The disadvantage of this approach is that we are
  // biased towards earlier sections. read_section could alternatively be a
  // shared variable. Though eventually, if we move to a MQ approach, we will be
  // picking random sections anyways.
  unsigned read_section =
      align_down<unsigned>(_num_sections, _num_blocks) + block_id;
  SectionMD secmd;
  while (true) {
    read_section = (read_section + _num_blocks) % _num_sections;

    unsigned section_busy = false;
    if (lane_id == 0) {
      section_busy = atomicExch(&(_section_metadata[read_section].busy), 1);
    }

    // If section was busy writing, try the next one
    section_busy = __shfl_sync(FULL_MASK, section_busy, 0);
    if (section_busy) {
      continue;
    }

    secmd = _section_metadata[read_section];

    // If section is empty, release it. If all sections are empty and all warps
    // are reading, there are no more tasks left, so the algorithm has
    // completed.
    const bool empty = (secmd.resv_start == secmd.resv_end) && !secmd.full;
    if (empty) {
      if (lane_id == 0) {
        section_busy = atomicExch(&(_section_metadata[read_section].busy), 0);
        assert(section_busy);
      }
      if (_num_empty_sections == _num_sections &&
          _num_warps_reading == _num_warps) {
        __syncwarp();
        return POP_DONE;
      }
      continue;
    }
    break;
  }

  const unsigned unwrapped_end = secmd.resv_end + _section_capacity;
  const unsigned available_tasks =
      (unwrapped_end - secmd.resv_start) % _section_capacity;

  // We will pop at most 1 task per lane
  *tasks_popped = min(warp_max_tasks, available_tasks);
  *tasks_popped = min(*tasks_popped, warpSize);

  // We pop into the lowest lanes
  if (lane_id < *tasks_popped) {
    const unsigned section_offset = _section_capacity * read_section;
    const unsigned read_offset =
        (secmd.resv_start + lane_id) % _section_capacity;
    *dst = *(_queue + section_offset + read_offset);
  }
  secmd.resv_start += *tasks_popped;
  assert(secmd.resv_start <= unwrapped_end);
  secmd.resv_start %= _section_capacity;

  // Update global and section metadata
  __syncwarp();
  if (lane_id == 0) {
    if (secmd.full) {
      atomicSub(&_num_full_sections, 1);
    }
    secmd.full = false;
    if (secmd.resv_start == secmd.resv_end) {
      atomicAdd(&_num_empty_sections, 1);
    }

    _section_metadata[read_section] = secmd;
    __threadfence();

    const unsigned was_busy =
        atomicExch(&(_section_metadata[read_section].busy), 0);
    assert(was_busy);

    atomicSub(&_num_warps_reading, 1);
  }

  __syncwarp();
  return POP_SUCCESS;
}
